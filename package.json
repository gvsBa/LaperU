{
  "name": "laperu-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "check": "npm run typecheck:all && npm run lint && npm run lint:api && npm run test:backend && npm run test:frontend && npm run build:all",
    "dev": "vite --config vite.config.js",
    "dev:frontend": "vite --config vite.config.js",
    "dev:backend": "npm run dev --workspace @laperu/backend",
    "dev:all": "concurrently -n frontend,backend -c auto \"npm:dev:frontend\" \"npm:dev:backend\"",
    "build": "vite build --config vite.config.js",
    "build:all": "npm run build && npm run build --workspace @laperu/backend",
    "typecheck": "tsc -b --pretty false",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspace @laperu/backend",
    "lint": "eslint .",
    "lint:api": "redocly lint backend/openapi.yaml",
    "test:backend": "npm run test --workspace @laperu/backend",
    "preview": "vite preview --config vite.config.js",
    "test:frontend": "vitest run --config vitest.frontend.config.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:local": "npm run build --workspace @laperu/backend && powershell -NoProfile -ExecutionPolicy Bypass -File backend/scripts/test-local-database.ps1 -BrowserSmoke"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.49.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "~8.2.4"
  }
}
