{
  "name": "laperu-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --workspace @laperu/backend",
    "dev:all": "concurrently -n frontend,backend -c auto \"npm:dev:frontend\" \"npm:dev:backend\"",
    "build": "tsc -b && vite build",
    "build:all": "npm run build && npm run build --workspace @laperu/backend",
    "typecheck": "tsc -b --pretty false",
    "typecheck:all": "npm run typecheck && npm run typecheck --workspace @laperu/backend",
    "lint": "eslint .",
    "test:backend": "npm run test --workspace @laperu/backend",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
